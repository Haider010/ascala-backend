database_url=postgresql://username:password@host:5432/database
client_id=your_highlevel_marketplace_client_id
client_secret=your_highlevel_marketplace_client_secret

# HighLevel Marketplace App shared secret. Keep backend-only.
GHL_APP_SHARED_SECRET=your_highlevel_marketplace_app_shared_secret

# Long random secret used by this backend to sign short-lived app sessions.
APP_SESSION_SECRET=replace_with_a_long_random_secret

# PostgreSQL connection pool. Keep max modest on Railway unless your DB plan supports more.
DB_POOL_MIN_CONNECTIONS=1
DB_POOL_MAX_CONNECTIONS=5

# Optional local-only direct/admin testing. Keep disabled in production unless you intentionally
# want direct login to mimic one installed GHL location without iframe signed context.
DIRECT_DEV_SESSION_ENABLED=false
DIRECT_DEV_COMPANY_ID=your_test_company_id
DIRECT_DEV_LOCATION_ID=your_test_location_id
DIRECT_DEV_USER_ID=your_test_user_id
DIRECT_DEV_USER_NAME=Your Name
DIRECT_DEV_EMAIL=you@example.com
DIRECT_DEV_ROLE=admin
DIRECT_DEV_CONTEXT_TYPE=agency
DIRECT_DEV_IS_AGENCY_OWNER=false
DIRECT_DEV_APP_STATUS=draft
DIRECT_DEV_VERSION_ID=your_marketplace_app_version_id

# Comma-separated frontend origins allowed to call this backend.
allowed_origins=http://localhost:5173,https://ascala-frontend-production.up.railway.app

# Optional: override default agent webhook URLs without changing code.
molly_webhook_url=https://primary-production-b3410.up.railway.app/webhook/08d8a0f2-afb8-4e80-91d6-0efa25d5f85e/chat
brandy_webhook_url=https://primary-production-b3410.up.railway.app/webhook/c65bf43d-45d3-42b5-9333-65e02bcd8835/chat
